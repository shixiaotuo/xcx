<view class="container theme-{{theme}}">
  <view class="header">
    <view class="header-top">
      <view class="date">{{date}}</view>
      <view class="header-actions">
        <view class="style-btn" bindtap="openThemeSheet">🎨 风格</view>
        <view class="history-btn" bindtap="goHistory">📜 历史</view>
      </view>
    </view>
    <view class="title">今天吃点啥子？</view>
    <view class="subtitle" wx:if="{{excludedYesterday}}">已帮你避开昨天吃的：{{excludedYesterday}}</view>
    <view class="subtitle" wx:else>饭前不纠结，吃前摇一摇。</view>
    <view class="fortune" wx:if="{{fortune}}">
      <view class="fortune-head">
        <view class="fortune-level">{{fortune.levelEmoji}} {{fortune.level}}</view>
        <view class="fortune-tip">{{fortune.tip}}</view>
      </view>
      <view class="fortune-yiji">
        <text class="fy yi">宜 · {{fortune.yi}}</text>
        <text class="fy ji">忌 · {{fortune.ji}}</text>
      </view>
      <view class="fortune-extra">
        <text>🎲 幸运数字 {{fortune.luckyNum}}</text>
        <text>🎨 幸运色 {{fortune.luckyColor}}</text>
      </view>
    </view>
  </view>

  <view class="cards">
    <view
      class="card {{activeId === item._id ? 'card-active' : ''}} {{coinHitId === item._id ? 'card-hit' : ''}}"
      wx:for="{{picks}}"
      wx:key="_id"
      bindtap="onPick"
      data-id="{{item._id}}"
      data-keyword="{{item.mapKeyword}}">
      <view class="emoji">{{item.emoji}}</view>
      <view class="name">{{item.name}}</view>
      <view class="chevron" wx:if="{{activeId === item._id}}">›</view>
    </view>
    <view class="pick-hint" wx:if="{{isCustom && activeName}}">🎯 你自选了：{{activeName}}</view>
  </view>

  <button class="reroll" bindtap="onReroll" loading="{{rerolling}}">🎲 换一批</button>

  <view class="fun-row">
    <view class="fun-btn" bindtap="openCoin">🪙 抛硬币</view>
    <view class="fun-btn" bindtap="openBlindbox">🎁 盲盒</view>
    <view class="fun-btn" bindtap="openCustom">🎯 自选</view>
    <view class="fun-btn" bindtap="openShare">📤 分享</view>
    <view class="fun-btn {{shakeEnabled ? 'fun-on' : ''}}" bindtap="toggleShake">📳 摇一摇</view>
  </view>

  <view class="shops" id="shopSection" wx:if="{{shops.length}}">
    <view class="shops-title">附近「{{activeName}}」的店</view>
    <view class="sort-tabs">
      <view class="sort-tab sort-active" bindtap="onSortChange" data-sort="distance">距离最近</view>
    </view>
    <view
      class="shop"
      wx:for="{{shops}}"
      wx:key="id"
      bindtap="onOpenMap"
      data-lat="{{item.lat}}"
      data-lng="{{item.lng}}"
      data-name="{{item.name}}">
      <view class="shop-name">{{item.name}}</view>
      <view class="shop-meta">{{item.distText}} · {{item.address}}</view>
    </view>
  </view>

  <view class="home" wx:if="{{isHome}}">
    <view class="home-emoji">🏠</view>
    <view class="home-title">今天回家吃～</view>
    <view class="home-tip">不搜周边店啦，回家好好吃一顿</view>
  </view>

  <view class="home takeout" wx:if="{{isTakeout}}">
    <view class="home-emoji">🥡</view>
    <view class="home-title">今天点外卖～</view>
    <view class="home-tip">打开外卖 App，躺着等送达</view>
  </view>

  <view class="empty" wx:if="{{!shops.length && !loading && !isHome && !isTakeout}}">
    <view class="empty-tip">点上面的卡片，看看附近有啥店 👆</view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <view class="empty-tip">加载中…</view>
  </view>

  <view class="sheet-mask" wx:if="{{sheetShow}}" bindtap="closeThemeSheet"></view>
  <view class="sheet" wx:if="{{sheetShow}}" catchtap="noop">
    <view class="sheet-title">选择风格</view>
    <view class="theme-grid">
      <view
        class="theme-opt {{theme === item.key ? 'active' : ''}}"
        wx:for="{{themes}}"
        wx:key="key"
        bindtap="onThemeChange"
        data-key="{{item.key}}">
        <view class="theme-swatch" style="background:{{item.swatch}}"></view>
        <view class="theme-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 抛硬币弹层 -->
  <view class="sheet-mask" wx:if="{{coinShow}}" bindtap="closeCoin"></view>
  <view class="modal" wx:if="{{coinShow}}" catchtap="noop">
    <view class="modal-title">🪙 抛硬币定胜负</view>
    <view class="coin {{coinFlipping ? 'coin-flip' : ''}}">🪙</view>
    <view class="coin-result" wx:if="{{coinResult}}">命运选中：{{coinResult.emoji}} {{coinResult.name}}</view>
    <view class="coin-tip" wx:else>点下方按钮，让硬币替你选</view>
    <button class="modal-btn" bindtap="flipCoin">抛！</button>
    <button class="modal-btn ghost" bindtap="closeCoin">关闭</button>
  </view>

  <!-- 盲盒弹层 -->
  <view class="sheet-mask" wx:if="{{blindboxShow}}" bindtap="closeBlindbox"></view>
  <view class="modal blindbox" wx:if="{{blindboxShow}}" catchtap="noop">
    <view class="modal-title">🎁 盲盒模式</view>
    <view class="box-emoji" wx:if="{{blindboxRevealing}}">❓</view>
    <block wx:else>
      <view class="box-emoji reveal">{{blindboxResult.emoji}}</view>
      <view class="box-name">{{blindboxResult.name}}</view>
      <view class="box-tip">命运让你吃这个</view>
    </block>
    <button class="modal-btn" wx:if="{{blindboxResult}}" bindtap="chooseBlindbox">就它了</button>
    <button class="modal-btn" wx:if="{{!blindboxRevealing && blindboxResult}}" bindtap="openBlindbox">再盲一次</button>
    <button class="modal-btn ghost" bindtap="closeBlindbox">关闭</button>
  </view>

  <!-- 自选弹层（手工录入） -->
  <view class="sheet-mask" wx:if="{{customShow}}" bindtap="closeCustom"></view>
  <view class="sheet" wx:if="{{customShow}}" catchtap="noop">
    <view class="sheet-title">🎯 自选录入</view>
    <input
      class="custom-input"
      placeholder="想吃什么？输入品类或店名"
      placeholder-class="custom-ph"
      value="{{customText}}"
      bindinput="onCustomInput"
      confirm-type="search"
      bindconfirm="confirmCustom" />
    <button class="modal-btn" bindtap="confirmCustom">搜附近店</button>
    <button class="modal-btn ghost" bindtap="closeCustom">关闭</button>
  </view>

  <!-- 分享卡弹层 -->
  <view class="sheet-mask" wx:if="{{shareShow}}" bindtap="closeShare"></view>
  <view class="sheet" wx:if="{{shareShow}}" catchtap="noop">
    <view class="sheet-title">今日战绩卡片</view>
    <image wx:if="{{shareImg}}" src="{{shareImg}}" class="share-img" mode="widthFix"></image>
    <view wx:else class="empty-tip">生成中…</view>
    <button class="share-save" bindtap="saveShare">保存到相册</button>
    <button class="share-save" open-type="share">转发给好友</button>
    <button class="modal-btn ghost" bindtap="closeShare">关闭</button>
  </view>

  <!-- 离屏 canvas：用于绘制分享卡 -->
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>

  <privacy-popup />
</view>
