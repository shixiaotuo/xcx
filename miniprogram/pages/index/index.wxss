/* ===== 全部色值走 CSS 变量，主题由 .container 上的 .theme-xxx 切换 ===== */
.container {
  padding: 40rpx 32rpx 90rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

.header {
  margin-bottom: 44rpx;
}
.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.date {
  font-size: 25rpx;
  color: var(--text-sub);
  font-weight: 500;
  letter-spacing: 1rpx;
}
.history-btn {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text);
  background: var(--card);
  border: var(--border-w) solid var(--border);
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  box-shadow: var(--shadow);
}
.title {
  font-size: 50rpx;
  font-weight: 700;
  margin-top: 18rpx;
  color: var(--text);
  letter-spacing: 1rpx;
}
.subtitle {
  font-size: 25rpx;
  color: var(--text-sub);
  font-weight: 500;
  margin-top: 12rpx;
}

.cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.card {
  background: var(--card);
  border: var(--border-w) solid var(--border);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: var(--shadow);
  transition: all .15s ease;
}
.card:active {
  transform: scale(0.985);
}
.card-active {
  background: var(--primary-soft);
  border-color: var(--primary-border);
  box-shadow: var(--shadow-active);
}
.emoji {
  font-size: 64rpx;
  line-height: 1;
}
.name {
  font-size: 38rpx;
  font-weight: 600;
  flex: 1;
  color: var(--text);
}
.chevron {
  font-size: 44rpx;
  color: var(--primary);
  font-weight: 600;
}

.reroll {
  margin-top: 36rpx;
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: var(--shadow-active);
}
.reroll::after {
  border: none;
}
.reroll:active {
  transform: scale(0.985);
}

/* 今日运势卡片 */
.fortune {
  margin-top: 28rpx;
  background: var(--primary-soft);
  border: var(--border-w) solid var(--primary-border);
  border-radius: 22rpx;
  padding: 26rpx 28rpx;
  box-shadow: var(--shadow);
}
.fortune-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.fortune-level {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
  white-space: nowrap;
}
.fortune-tip {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-sub);
  font-weight: 500;
  line-height: 1.5;
}
.fortune-yiji {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}
.fy {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 14rpx 0;
}
.fy.yi {
  color: var(--primary);
  background: var(--card);
  border: var(--border-w) solid var(--primary-border);
}
.fy.ji {
  color: var(--text-sub);
  background: var(--card);
  border: var(--border-w) solid var(--border);
}
.fortune-extra {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--text-sub);
  font-weight: 500;
}

/* 趣味按钮行 */
.fun-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.fun-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text);
  background: var(--card);
  border: var(--border-w) solid var(--border);
  border-radius: 999rpx;
  padding: 18rpx 0;
  box-shadow: var(--shadow);
}
.fun-btn:active {
  transform: scale(0.97);
}
.fun-on {
  color: var(--primary);
  border-color: var(--primary-border);
  background: var(--primary-soft);
}

/* 命中卡片高亮（抛硬币结果） */
.card-hit {
  border-color: var(--primary) !important;
  background: var(--primary-soft);
  box-shadow: var(--shadow-active);
}

/* 居中弹层（抛硬币 / 盲盒） */
.modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 60;
  width: 560rpx;
  box-sizing: border-box;
  background: var(--card);
  border: var(--border-w) solid var(--border);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-shadow: var(--shadow-active);
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 24rpx;
}
.modal-btn {
  margin-top: 18rpx;
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.modal-btn::after {
  border: none;
}
.modal-btn.ghost {
  background: var(--card);
  color: var(--text-sub);
  border: var(--border-w) solid var(--border);
}

/* 抛硬币 */
.coin {
  font-size: 150rpx;
  line-height: 1;
  margin: 8rpx 0 22rpx;
}
.coin-flip {
  animation: coinflip 0.5s linear infinite;
}
@keyframes coinflip {
  0% { transform: rotateY(0deg); }
  100% { transform: rotateY(360deg); }
}
.coin-result {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 22rpx;
}
.coin-tip {
  font-size: 25rpx;
  color: var(--text-sub);
  margin-bottom: 22rpx;
}

/* 盲盒 */
.box-emoji {
  font-size: 160rpx;
  line-height: 1;
  margin: 10rpx 0 18rpx;
}
.box-emoji.reveal {
  animation: pop 0.4s ease;
}
@keyframes pop {
  0% { transform: scale(0.3); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
.box-name {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 10rpx;
}
.box-tip {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 26rpx;
}

/* 分享卡 */
.share-img {
  width: 100%;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}
.share-save {
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.share-save::after {
  border: none;
}
/* 离屏 canvas，仅供绘制，不显示 */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 900px;
}

.shops {
  margin-top: 48rpx;
}
.shops-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
  margin-bottom: 18rpx;
}
.sort-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.sort-tab {
  font-size: 25rpx;
  font-weight: 500;
  color: var(--text-sub);
  background: var(--card);
  border: var(--border-w) solid var(--border);
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}
.sort-active {
  color: #fff;
  background: var(--primary);
  border-color: var(--primary);
  box-shadow: var(--shadow-active);
}
.shop {
  background: var(--card);
  border: var(--border-w) solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow);
}
.shop:active {
  transform: scale(0.99);
}
.shop-name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--text);
}
.shop-meta {
  font-size: 23rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
}

.empty,
.loading {
  margin-top: 60rpx;
  text-align: center;
}
.empty-tip {
  color: var(--text-sub);
  font-size: 27rpx;
  font-weight: 500;
}

.home {
  margin-top: 48rpx;
  background: var(--home-bg);
  border: var(--border-w) solid var(--home-border);
  border-radius: 28rpx;
  padding: 56rpx 40rpx;
  text-align: center;
  box-shadow: var(--shadow);
}
.home.takeout {
  background: var(--takeout-bg);
  border-color: var(--takeout-border);
}
.home-emoji {
  font-size: 88rpx;
  line-height: 1;
}
.home-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-top: 20rpx;
  color: var(--text);
}
.home-tip {
  font-size: 25rpx;
  color: var(--text-sub);
  font-weight: 500;
  margin-top: 12rpx;
}
