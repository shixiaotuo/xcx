/* ===== 全部色值走 CSS 变量，主题由 .container 上的 .theme-xxx 切换 ===== */
.container {
  padding: 40rpx 32rpx 90rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

.header {
  margin-bottom: 44rpx;
}
.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.date {
  font-size: 25rpx;
  color: var(--text-sub);
  font-weight: 500;
  letter-spacing: 1rpx;
}
.history-btn {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text);
  background: var(--card);
  border: var(--border-w) solid var(--border);
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  box-shadow: var(--shadow);
}
.title {
  font-size: 50rpx;
  font-weight: 700;
  margin-top: 18rpx;
  color: var(--text);
  letter-spacing: 1rpx;
}
.subtitle {
  font-size: 25rpx;
  color: var(--text-sub);
  font-weight: 500;
  margin-top: 12rpx;
}

.cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.card {
  background: var(--card);
  border: var(--border-w) solid var(--border);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: var(--shadow);
  transition: all .15s ease;
}
.card:active {
  transform: scale(0.985);
}
.card-active {
  background: var(--primary-soft);
  border-color: var(--primary-border);
  box-shadow: var(--shadow-active);
}
.emoji {
  font-size: 64rpx;
  line-height: 1;
}
.name {
  font-size: 38rpx;
  font-weight: 600;
  flex: 1;
  color: var(--text);
}
.chevron {
  font-size: 44rpx;
  color: var(--primary);
  font-weight: 600;
}

.reroll {
  margin-top: 36rpx;
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: var(--shadow-active);
}
.reroll::after {
  border: none;
}
.reroll:active {
  transform: scale(0.985);
}

.shops {
  margin-top: 48rpx;
}
.shops-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
  margin-bottom: 18rpx;
}
.sort-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.sort-tab {
  font-size: 25rpx;
  font-weight: 500;
  color: var(--text-sub);
  background: var(--card);
  border: var(--border-w) solid var(--border);
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}
.sort-active {
  color: #fff;
  background: var(--primary);
  border-color: var(--primary);
  box-shadow: var(--shadow-active);
}
.shop {
  background: var(--card);
  border: var(--border-w) solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow);
}
.shop:active {
  transform: scale(0.99);
}
.shop-name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--text);
}
.shop-meta {
  font-size: 23rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
}

.empty,
.loading {
  margin-top: 60rpx;
  text-align: center;
}
.empty-tip {
  color: var(--text-sub);
  font-size: 27rpx;
  font-weight: 500;
}

.home {
  margin-top: 48rpx;
  background: var(--home-bg);
  border: var(--border-w) solid var(--home-border);
  border-radius: 28rpx;
  padding: 56rpx 40rpx;
  text-align: center;
  box-shadow: var(--shadow);
}
.home.takeout {
  background: var(--takeout-bg);
  border-color: var(--takeout-border);
}
.home-emoji {
  font-size: 88rpx;
  line-height: 1;
}
.home-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-top: 20rpx;
  color: var(--text);
}
.home-tip {
  font-size: 25rpx;
  color: var(--text-sub);
  font-weight: 500;
  margin-top: 12rpx;
}
