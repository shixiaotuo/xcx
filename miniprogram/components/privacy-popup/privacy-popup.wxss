/* 隐私弹窗：固定中性白卡，不随主题变色，保证各主题下可读 */
.pp-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 0 40rpx;
}

.pp-dialog {
  width: 100%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.18);
}

.pp-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f1f1f;
  text-align: center;
  margin-bottom: 24rpx;
}

.pp-body {
  font-size: 28rpx;
  line-height: 1.6;
  color: #555555;
}

.pp-link {
  color: #2f80ed;
  text-decoration: underline;
}

.pp-actions {
  display: flex;
  margin-top: 40rpx;
}

.pp-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.pp-btn-default {
  background: #f2f2f2;
  color: #666666;
  margin-right: 24rpx;
}

.pp-btn-primary {
  background: #4ca98c;
  color: #ffffff;
  font-weight: 600;
}
